@model Reserva
@{ ViewData["Title"] = "Detalle de reserva"; var estado = Presentacion.Estado(Model); var admin = User.IsInRole("Administrador"); }
<a asp-action="Index" class="back-link">← Volver a reservas</a>
<div class="page-head"><div><p class="eyebrow">TU RESERVA</p><h1>@Model.Espacio.Nombre</h1><p class="folio">@Model.Folio</p></div><span class="badge @estado">@estado</span></div>
@if(Presentacion.PuedePagar(Model))
{
    <div class="next-action"><div><h2>Tu espacio está a un paso.</h2><p>Completa el pago para confirmar la reserva.</p></div>@if(admin){<a class="button" asp-controller="Pagos" asp-action="Crear" asp-route-reservaId="@Model.IdReserva">Registrar pago →</a>}else{<a class="button" asp-controller="Pagos" asp-action="Pagar" asp-route-id="@Model.IdReserva">Pagar ahora · Bs @Model.CostoTotal.ToString("N2")</a>}</div>
}
else if(Presentacion.Vencida(Model)){<div class="alert error"><strong>El horario de inicio ya pasó.</strong> Esta reserva está vencida y no admite pago. Reprograma el horario o cancélala.</div>}
<div class="checkout-grid"><section class="panel"><img class="reservation-photo" src="@Presentacion.Foto(Model.Espacio)" alt="Fotografía referencial del espacio" /><dl class="detail-grid"><div><dt>Cliente</dt><dd>@Model.Usuario.Nombre</dd></div><div><dt>Correo</dt><dd>@Model.Usuario.Correo</dd></div><div><dt>Inicio</dt><dd>@Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Fin</dt><dd>@Model.FechaFin.ToString("dd/MM/yyyy HH:mm")</dd></div></dl><h2>Equipamiento incluido</h2><div class="table-wrap"><table><thead><tr><th>Equipo</th><th>Cantidad</th><th>Tarifa / hora</th></tr></thead><tbody>@foreach(var e in Model.ReservaEquipamientos){<tr><td>@e.Equipamiento.Nombre</td><td>@e.Cantidad</td><td>Bs @e.PrecioHora.ToString("N2")</td></tr>}@if(Model.ReservaEquipamientos.Count == 0){<tr><td colspan="3" class="empty">Sin equipos adicionales.</td></tr>}</tbody></table></div></section><aside class="panel summary-panel"><p class="eyebrow">RESUMEN</p><h2>@Model.HorasReservadas.ToString("N2") horas</h2><div class="receipt-total"><span>Total</span><strong>Bs @Model.CostoTotal.ToString("N2")</strong></div>
@if(Model.Pago is not null){<a class="button full" asp-controller="Pagos" asp-action="Detalles" asp-route-id="@Model.Pago.IdPago">Ver comprobante</a>}
@if(Model.Estado == EstadoReserva.Pendiente && Model.Pago is null){<a class="button ghost full" asp-action="Editar" asp-route-id="@Model.IdReserva">@(Presentacion.Vencida(Model) ? "Reprogramar reserva" : "Editar reserva")</a><a class="later-link" asp-action="Eliminar" asp-route-id="@Model.IdReserva">Eliminar reserva</a>}
@if(Model.Estado is EstadoReserva.Pendiente or EstadoReserva.Confirmada){<form asp-action="Cancelar" asp-route-id="@Model.IdReserva" method="post" data-confirm="¿Cancelar esta reserva?"><button type="submit" class="ghost full">Cancelar reserva</button></form>@if(admin && Model.Estado == EstadoReserva.Confirmada){<form asp-action="Completar" asp-route-id="@Model.IdReserva" method="post"><button class="ghost full" type="submit">Marcar completada</button></form>}}
<p class="help">Si ya pagaste, solicita a administración el reembolso antes de cancelar. Las fotografías son referenciales.</p></aside></div>
