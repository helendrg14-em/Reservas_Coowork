@model EquipoForm
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo registro" : "Editar registro"; }
<div class="page-head">
<div>
<p class="eyebrow">EQUIPAMIENTO</p>
<h1>@ViewData["Title"]</h1>
<p>Completa los datos del catálogo.</p>
</div>
</div>
<form method="post" asp-action="@(Model.Id == 0 ? "Crear" : "Editar")" asp-route-id="@Model.Id" class="panel form-card">
<div asp-validation-summary="All">
</div>
<div class="form-grid">
<div class="field">
<label for="Codigo">Código (automático)</label>
@* Sin name: el servidor asigna el código; este campo solo lo muestra. *@
<input id="Codigo" value="@Model.Codigo" readonly />
</div>
<div class="field">
<label asp-for="Nombre">
</label>
<input asp-for="Nombre" />
<span asp-validation-for="Nombre">
</span>
</div>
<div class="field">
<label asp-for="Tipo">
</label>
<input asp-for="Tipo" list="tipos-equipo" placeholder="Ej.: Audiovisual" />
<datalist id="tipos-equipo">@foreach (var tipo in Model.TiposExistentes) { <option value="@tipo"></option> }</datalist>
<span asp-validation-for="Tipo">
</span>
</div>
<div class="field">
<label asp-for="PrecioHora">
</label>
<input asp-for="PrecioHora" type="number" step="0.01" min="0.01" max="999999.99" />
<span asp-validation-for="PrecioHora">
</span>
</div>
</div>
<p class="help">El código se asigna automáticamente (EQ-01, EQ-02…) y continúa la numeración.Actualizar la tarifa no modifica el total de reservas ya guardadas.</p>
<div class="form-actions">
<button type="submit">Guardar registro</button>
<a asp-action="Index" class="button ghost">Volver</a>
</div>
</form>
