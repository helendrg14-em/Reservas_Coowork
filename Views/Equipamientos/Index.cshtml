@model List<Equipamiento>
@{ ViewData["Title"] = "Equipamiento"; }
<div class="page-head">
<div>
<p class="eyebrow">CATÁLOGO WORKHUB</p>
<h1>Equipamiento</h1>
<p>Todo lo que complementa un buen espacio de trabajo.</p>
</div>@if(User.IsInRole("Administrador")){<a class="button" asp-action="Crear">+ Nuevo registro</a>}</div>
<form method="get" class="filters">
<div class="field">
<label for="buscar">Buscar por nombre o código</label>
<input id="buscar" name="buscar" value="@ViewData["Buscar"]" placeholder="Escribe tu búsqueda…" />
</div>
<button type="submit">Buscar</button>
<a asp-action="Index" class="button ghost">Limpiar</a>
</form>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>NOMBRE / CÓDIGO</th>
<th>TIPO</th>
<th class="numeric">TARIFA / HORA</th>
<th>ACCIONES</th>
</tr>
</thead>
<tbody>
@foreach(var e in Model){<tr>
<td>
<strong>@e.Nombre</strong>
<small>@e.Codigo</small>
</td>
<td>@e.Tipo</td>
<td class="numeric">Bs @e.PrecioHora.ToString("N2")</td>
<td>
<div class="actions">
<a asp-action="Detalles" asp-route-id="@e.IdEquipo">Ver</a>@if(User.IsInRole("Administrador")){<a asp-action="Editar" asp-route-id="@e.IdEquipo">Editar</a>
<a asp-action="Eliminar" asp-route-id="@e.IdEquipo">Eliminar</a>}</div>
</td>
</tr>}
@if(Model.Count == 0){<tr>
<td colspan="6" class="empty">No hay registros para esta búsqueda.</td>
</tr>}
</tbody>
</table>
</div>
<p class="help">@Model.Count registro(s). Las tarifas se expresan en bolivianos.</p>
