@model RegistroViewModel
@{ ViewData["Title"] = "Crear cuenta"; }
<section class="auth">
<div class="auth-story">
<span class="eyebrow">EMPIEZA ALGO BUENO</span>
<h1>Un lugar para<br />trabajar mejor.</h1>
<p>Crea tu cuenta, explora los espacios y organiza tu próxima visita.</p>
</div>
<div class="auth-form">
<h2>Crear cuenta</h2>
<form method="post" asp-action="Registro">
<div asp-validation-summary="All">
</div>
<div class="field">
<label asp-for="Nombre">
</label>
<input asp-for="Nombre" autocomplete="name" />
<span asp-validation-for="Nombre">
</span>
</div>
<div class="field">
<label asp-for="Correo">
</label>
<input asp-for="Correo" autocomplete="email" />
<span asp-validation-for="Correo">
</span>
</div>
<div class="field">
<label asp-for="Telefono">
</label>
<input asp-for="Telefono" autocomplete="tel" />
<span asp-validation-for="Telefono">
</span>
</div>
<div class="form-grid">
<div class="field">
<label asp-for="Password">
</label>
<input asp-for="Password" autocomplete="new-password" />
<span asp-validation-for="Password">
</span>
</div>
<div class="field">
<label asp-for="ConfirmPassword">
</label>
<input asp-for="ConfirmPassword" autocomplete="new-password" />
<span asp-validation-for="ConfirmPassword">
</span>
</div>
</div>
<button type="submit">Crear mi cuenta</button>
</form>
<p class="help">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>
</p>
</div>
</section>
