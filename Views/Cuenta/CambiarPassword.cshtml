@model CambiarPasswordViewModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<header class="page-heading"><h1>Cambiar contraseña</h1></header>
<form asp-action="CambiarPassword" method="post" class="panel form-panel">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field"><label asp-for="PasswordActual"></label><input asp-for="PasswordActual" autocomplete="current-password" /><span asp-validation-for="PasswordActual"></span></div>
    <div class="field"><label asp-for="PasswordNueva"></label><input asp-for="PasswordNueva" autocomplete="new-password" /><span asp-validation-for="PasswordNueva"></span></div>
    <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
    <button class="button" type="submit">Guardar contraseña</button>
    <a asp-action="Index">Volver a mi cuenta</a>
</form>
