@model ErrorViewModel
@{ ViewData["Title"] = "No se pudo completar la solicitud"; }
<div class="panel">
<h1>No se pudo completar la solicitud</h1>
<p>Intente nuevamente. Si el problema continúa, solicite al administrador que revise la conexión con SQL Server y los registros de la aplicación.</p>
<p class="help">Referencia: @Model.RequestId</p>
<a class="button" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
